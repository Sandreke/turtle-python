from turtle import *
from math import *

speed(0)
bgcolor("black")
goto(0, -40)

# Draw leaves
for i in range(16):
    for j in range(18):
        color('#FFA216')
        rt(90)
        circle(150 - j * 6, 90)
        lt(90)
        circle(150 - j * 6, 90)
        rt(180)
    circle(40, 24)

# Draw flower center
color('black')
shape('circle')
shapesize(0.5)
fillcolor('#8B4513')
golden_ang = 137.508
phi = golden_ang * (pi / 180)

for i in range(140):
    r = 4 * sqrt(i)
    theta = i * phi
    x = r * cos(theta)
    y = r * sin(theta)
    penup()
    goto(x, y)
    setheading(i * golden_ang)
    pendown()
    stamp()

# Texto en el centro de la flor
penup()
goto(0, -10)   # Ajusta la posición del texto
color("orange")
write("C.E.V.M", align="center", font=("Arial", 20, "bold"))

hideturtle()
done()
